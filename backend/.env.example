# Copy this to backend/.env and fill in real values. Never commit backend/.env.

# NASA Earthdata — required for IMERG, HLS, Landsat, SRTM
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus Marine — required for primary ocean current forcing (Component F)
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# Copernicus Climate Data Store — required for ERA5-Land
CDS_API_KEY=

# Copernicus Data Space — required for Sentinel-2
CDSE_USERNAME=
CDSE_PASSWORD=

DATA_DIR=./data
AOI_NAME=aqaba
