# Secrets — never commit
.env
.env.*
!.env.example
.cdsapirc

# Python environment
.venv/
backend/.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Raw downloads — reproducible with scripts/, large, not worth versioning
data/raw/*
!data/raw/aoi/
!data/raw/aoi/**
!data/raw/.gitkeep
!**/.gitkeep

# Intermediates. The local catchment test fixture MUST NOT be shared —
# contract §4 P1 gives catchment ownership to Mahdi, and a second AQ-C{NN}
# geometry in circulation is exactly what the ID contract prevents.
data/interim/
data/outputs/

# ...except the outlet candidate list, which is a small shared reference:
# all 72 discharge points the 30 m delineation resolved on Jordan's coast.
!data/interim/hydro/
!data/interim/hydro/outlet_candidates.csv

# Working chains that regenerate from scripts/ — large and re-fetchable
data/interim/srtm/
data/interim/tiles/
data/raw/srtm/

# data/aoi/ and data/processed/ ARE committed on purpose: they are the shared
# contract paths from 00-contracts.md §3 that other people's code reads
# (catchments, outlets, reef zones, coastline, depth field, feature tables).
# Keep individual files small — anything over a few MB belongs in Storage.

# Large rasters under data/processed/ — the contract paths are committed, but
# the 30 m DEM alone is 65 MB. Regenerate with scripts/03_dem_fetch.py; the
# vectors and feature tables stay committed.
data/processed/dem/*.tif
data/processed/**/*.tif

# GDAL statistics sidecars. Derived from the raster on first read, regenerated
# automatically, and they churn whenever anyone opens the file in QGIS.
*.aux.xml

# OS
.DS_Store

# Per-event processed outputs regenerate from scripts/ and are large. The
# committed contract paths under data/processed/events/ are the small shared
# artefacts only: the catalogue, the climatology, and the sweep manifests.
data/processed/events/AQ-*/
data/processed/events/AQ-*.nc
data/processed/events/AQ-*.parquet
data/processed/events/*.nc

# Frontend — workstream 6. Build output and installed packages only.
#
# Everything under frontend/public/ IS committed on purpose, including the
# derived basemap GeoJSON, the six woff2 faces and the vendored MapLibre RTL
# plugin. DoD item 9 is "works with wifi off", so no frontend asset may be
# fetched at runtime — and the compose build context is ./frontend, so nothing
# under data/ is reachable at image-build time even if we wanted to derive it
# there. `data/processed/**/*.tif` above also means the bathymetry raster the
# isobaths come from is not in git, so the derived contours have to be.
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/*.tsbuildinfo
frontend/.env.local


# Root-level raw downloads (1.2 GB IMERG + 82 MB ERA5-Land month files).
# These live at ./raw and ./era5 rather than data/raw, so the data/** rules
# above never covered them. Reproducible via the fetch scripts; ERA5 months in
# particular are what scripts/13_extract_sro_all_days.py reads.
/raw/
/era5/

# Model artifacts: the .joblib is 331 KB and the ledger is the index.
# Both committed on purpose - a stored prediction references a version id, and
# the artifact behind it must be retrievable or the prediction is unreproducible.
!data/models/
!data/models/*.joblib
!data/models/*.jsonl

# Baked satellite basemap for the plume renderer. Derived, ~8 MB, and regenerated in
# ~30 s by scripts/fetch_basemap_raster.py. Same reasoning as the ACA raster: the
# committed contract paths are the small shared artefacts, not the imagery. The renderer
# degrades to a plain background and SAYS SO when it is absent, so a fresh clone is
# honest rather than broken.
data/processed/basemap/

# Terrain-RGB tile pyramid for the 3D Journey (feature 14) -- derived from the real
# merged DEM+bathymetry surface by scripts/tile_terrain_rgb.py. Unlike the basemap
# raster above, this IS committed (as of 9 Aug 2026): the source merged raster
# (data/processed/dem/terrain_merged_utm36n.tif) is itself not committed and its raw
# DEM/bathymetry inputs live under the git-ignored data/raw/, so no teammate besides
# the machine that baked it can actually regenerate these tiles. The "degrade
# honestly, not silently" fallback doesn't fire anyway -- Journey3D.tsx calls
# m.setTerrain() unconditionally with no absence-check -- so until that's fixed,
# committing the baked tiles is the only way other machines see real terrain at all.

# Second, browser-reachable copy of the same baked Esri imagery data/processed/basemap/
# already holds (see layers/imagery.ts) -- a `cp`, not a second fetch.
#
# Committed (as of 9 Aug 2026), unlike the basemap raster above: Journey3D.tsx's
# loadImageryCorners() degrades honestly when this is absent (no drape, real
# terrain still shows), so the failure mode isn't broken -- it's silently
# different, every teammate who hasn't run both fetch scripts sees plain
# color-relief terrain with no photographic texture and no way to tell anything
# is missing. Same reasoning as the terrain-RGB tile pyramid: small (~5MB) and
# worth guaranteeing everyone sees the same scene over keeping the repo lean.

