# Secrets — never commit
.env
.env.*
!.env.example
.cdsapirc

# Python environment
.venv/
backend/.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Raw downloads — reproducible with scripts/, large, not worth versioning
data/raw/*
!data/raw/aoi/
!data/raw/aoi/**
!data/raw/.gitkeep
!**/.gitkeep

# Intermediates. The local catchment test fixture MUST NOT be shared —
# contract §4 P1 gives catchment ownership to Mahdi, and a second AQ-C{NN}
# geometry in circulation is exactly what the ID contract prevents.
data/interim/
data/outputs/

# ...except the outlet candidate list, which is a small shared reference:
# all 72 discharge points the 30 m delineation resolved on Jordan's coast.
!data/interim/hydro/
!data/interim/hydro/outlet_candidates.csv

# Working chains that regenerate from scripts/ — large and re-fetchable
data/interim/srtm/
data/interim/tiles/
data/raw/srtm/

# data/aoi/ and data/processed/ ARE committed on purpose: they are the shared
# contract paths from 00-contracts.md §3 that other people's code reads
# (catchments, outlets, reef zones, coastline, depth field, feature tables).
# Keep individual files small — anything over a few MB belongs in Storage.

# Large rasters under data/processed/ — the contract paths are committed, but
# the 30 m DEM alone is 65 MB. Regenerate with scripts/03_dem_fetch.py; the
# vectors and feature tables stay committed.
data/processed/dem/*.tif
data/processed/**/*.tif

# OS
.DS_Store

# Per-event processed outputs regenerate from scripts/ and are large. The
# committed contract paths under data/processed/events/ are the small shared
# artefacts only: the catalogue, the climatology, and the sweep manifests.
data/processed/events/AQ-*/
data/processed/events/AQ-*.nc
data/processed/events/AQ-*.parquet
data/processed/events/*.nc
