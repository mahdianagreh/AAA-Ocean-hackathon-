# python
.venv/
__pycache__/
*.pyc

# data - rebuild with scripts/, never commit rasters or shapefiles
data/**
!data/**/
!data/.gitkeep
!data/**/.gitkeep
!data/aoi/*.geojson

# small shared handoff vectors - teammates need these without re-downloading
# the 177 MB HydroBASINS source. Keep under ~1 MB each.
!data/processed/vectors/*.gpkg
!data/processed/features/*.parquet
!data/interim/hydro/outlet_candidates.csv

# os
.DS_Store

# tile cache - re-fetchable
data/interim/tiles/

# SRTM working chain - regenerate with scripts/09_srtm_crosscheck.py
data/interim/srtm/
data/raw/srtm/
