EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ── Supabase Cloud ────────────────────────────────────────────────────────
# The stack has no local database. All three containers talk to Supabase, so
# the demo needs a live connection - a deliberate decision, see the header of
# docker-compose.yml. Nizar owns the project and the schema (workstream 3).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, for the model layer's SupabaseFeatureStore.
SUPABASE_DSN=

# ── Docker ────────────────────────────────────────────────────────────────
# Worker poll interval, seconds. Lower it to make the log chattier while
# debugging; there is no queue to read until the schema lands.
REEFSHIELD_WORKER_POLL=30
# Which feature source the trainer uses: parquet | supabase | stub.
# Unset resolves to the real matrix, or fails - it never falls back to stub.
REEFSHIELD_FEATURE_SOURCE=

# Supabase Postgres — value intentionally blank; never commit a real one.
SUPABASE_DB_URL=
DATABASE_URL=
